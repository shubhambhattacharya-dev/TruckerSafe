cat << 'EOF' > .gitignore
# Secrets and environment variables
.env
.env.*
!.env.example
!.env.*.example

# Node.js / React / TypeScript
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python / Django
__pycache__/
*.py[cod]
*.pyo
*.pyd
.python-version
.venv/
venv/
env/
backend/.venv/
backend/venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Django local files
db.sqlite3
db.sqlite3-journal
staticfiles/

# Test artifacts
playwright-report/
test-results/
coverage/
.nyc_output/

# Logs and temporary files
*.log
*.tmp
*.bak

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local configuration and credentials
secrets/
EOF